# ============================================
# MIKYRA LIFE - Variables de entorno
# Copia este archivo a .env.local y rellena
# ============================================

# --- SUPABASE (Dashboard → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- STRIPE ---
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- RESEND (emails transaccionales) ---
RESEND_API_KEY=re_...
# Dirección "from" verificada en Resend. Sin verificar usa el dominio de test.
EMAIL_FROM=MIKYRA LIFE <onboarding@resend.dev>

# --- CLOUDINARY (imágenes de producto) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- CJ DROPSHIPPING (API v2.0) ---
CJ_API_KEY=
CJ_EMAIL=
CJ_PASSWORD=

# --- APP ---
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=MIKYRA LIFE
# En producción: https://mikyra.roadshop.online

# --- ADMIN (protección básica del panel /admin) ---
# Cambia este valor por una contraseña larga y aleatoria
ADMIN_TOKEN=cambia-esto-por-un-token-largo
